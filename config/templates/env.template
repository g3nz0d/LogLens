# 🔧 LogLens Environment Configuration Template
# Copy this file to .env and fill in your organization's values

# ======================================
# SLACK AUTHENTICATION (Required)
# ======================================
# Get these from your Slack app at https://api.slack.com/apps

# Bot User OAuth Token (starts with xoxb-)
# Used for: Sending messages, responding to commands
# Where to find: Install App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token (starts with xapp-)  
# Used for: Socket Mode connection
# Where to find: Socket Mode → App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token-here

# Signing Secret (hex string)
# Used for: Verifying requests from Slack
# Where to find: Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# ======================================
# CORALOGIX INTEGRATION (Required)
# ======================================
# Your organization's Coralogix instance

# Base URL for your Coralogix instance
# Examples: https://app.coralogix.com, https://yourorg.coralogix.com
CORALOGIX_BASE_URL=https://app.coralogix.com

# Optional: Coralogix API token for advanced features
# CORALOGIX_API_TOKEN=your-api-token-here

# ======================================
# SALESFORCE INTEGRATION (Required)
# ======================================
# Your organization's Salesforce instance

# Salesforce opportunities base URL
# Example: https://yourorg.lightning.force.com/lightning/o/Opportunity/list?filterName=__Recent
SALESFORCE_OPP_URL=https://yourorg.lightning.force.com/lightning/o/Opportunity/list?filterName=__Recent

# Salesforce API base URL (for API calls)
# Example: https://yourorg.my.salesforce.com
SALESFORCE_API_BASE_URL=https://yourorg.my.salesforce.com

# Optional: Salesforce API credentials for enrichment
# SALESFORCE_CLIENT_ID=your-client-id
# SALESFORCE_CLIENT_SECRET=your-client-secret
# SALESFORCE_USERNAME=your-username
# SALESFORCE_PASSWORD=your-password
# SALESFORCE_SECURITY_TOKEN=your-security-token

# ======================================
# BACKOFFICE INTEGRATION (Required)
# ======================================
# Your organization's internal systems

# Base URL for BackOffice/internal systems
# Example: https://backoffice.yourorg.com, https://smithy.internal.yourorg.io
BACKOFFICE_BASE_URL=https://backoffice.yourorg.com

# BackOffice URL paths (customize for your system)
BACKOFFICE_HOME_PATH=/applications
BACKOFFICE_SEARCH_PATH=/app/search
BACKOFFICE_TENANT_PREFIX=/app/tenants-
BACKOFFICE_ACCOUNT_PREFIX=/app/accounts-
BACKOFFICE_QUERY_SUFFIX=

# ======================================
# ZENDESK INTEGRATION (Optional)
# ======================================
# Your organization's ZenDesk instance

# Base URL for ZenDesk
# Example: https://yourorg.zendesk.com
# ZENDESK_BASE_URL=https://yourorg.zendesk.com

# Optional: ZenDesk API credentials
# ZENDESK_EMAIL=your-zendesk-email
# ZENDESK_TOKEN=your-zendesk-api-token

# ======================================
# LICENSING API (Optional)
# ======================================
# For license status monitoring

# Licensing API base URL (internal service)
# LICENSING_API_BASE_URL=https://licensing-api.internal.yourorg.io
# LICENSING_API_TOKEN=your-licensing-api-token
# LICENSING_BASE_URL=https://licensing.internal.yourorg.io

# ======================================
# REDASH/ANALYTICS (Optional)
# ======================================
# For analytics dashboards and queries

# Redash base URL
# REDASH_BASE_URL=https://redash.yourorg.com
# REDASH_API_TOKEN=your-redash-api-token

# ======================================
# DATA ENRICHMENT (Optional)
# ======================================
# File paths for account enrichment

# Path to accounts CSV file (relative to project root)
# Default: ./config/accounts.csv
ACCOUNT_INDEX_PATH=./config/accounts.csv

# Path to channel mapping JSON file
# Default: ./config/channel-mapping.json
CHANNEL_MAPPING_PATH=./config/channel-mapping.json

# ======================================
# DEPLOYMENT CONFIGURATION
# ======================================
# Settings for your deployment environment

# Node.js environment
NODE_ENV=production

# Port for web server (if needed)
# Most deployments handle this automatically
# PORT=3000

# Timezone for log timestamps
# TZ=UTC

# ======================================
# FEATURE FLAGS (Optional)
# ======================================
# Enable/disable optional features

# Enable licensing status integration
# ENABLE_LICENSING=true

# Enable Salesforce enrichment  
# ENABLE_SALESFORCE=true

# Enable ZenDesk integration
# ENABLE_ZENDESK=false

# Enable Redash analytics
# ENABLE_REDASH=false

# Enable debug logging
# DEBUG_LOGGING=false

# ======================================
# EXTERNAL INTEGRATIONS (Optional)
# ======================================
# Additional service integrations

# DataDog integration
# DATADOG_API_KEY=your-datadog-api-key
# DATADOG_APP_KEY=your-datadog-app-key
# DATADOG_BASE_URL=https://app.datadoghq.com

# Grafana integration
# GRAFANA_BASE_URL=https://grafana.yourorg.com
# GRAFANA_API_TOKEN=your-grafana-api-token

# Prometheus integration
# PROMETHEUS_BASE_URL=https://prometheus.yourorg.com

# ======================================
# SECURITY SETTINGS (Optional)
# ======================================
# Additional security configurations

# API rate limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# Request timeout (milliseconds)
# REQUEST_TIMEOUT_MS=5000

# Maximum concurrent requests
# MAX_CONCURRENT_REQUESTS=10

# ======================================
# CUSTOMIZATION (Optional) 
# ======================================
# Customize LogLens behavior

# Default time range for log queries (minutes)
# DEFAULT_LOG_TIME_RANGE=120

# Maximum UIDs to display in results
# MAX_UIDS_DISPLAY=10

# Custom app name for branding
# CUSTOM_APP_NAME=LogLens

# ======================================
# EXAMPLE CONFIGURATION
# ======================================
# Remove the # to enable these example values

# Example for a typical organization:
# SLACK_BOT_TOKEN=xoxb-1234567890123-1234567890123-abcdefghijklmnopqrstuvwx
# SLACK_APP_TOKEN=xapp-1-A1234567890-1234567890123-abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwx
# SLACK_SIGNING_SECRET=abcdef1234567890abcdef1234567890
# CORALOGIX_BASE_URL=https://acmecorp.coralogix.com
# SALESFORCE_OPP_URL=https://acmecorp.lightning.force.com/lightning/o/Opportunity/list?filterName=__Recent
# BACKOFFICE_BASE_URL=https://backoffice.acmecorp.com
# ZENDESK_BASE_URL=https://acmecorp.zendesk.com

# ======================================
# SETUP VALIDATION
# ======================================
# Test your configuration with these commands:
# 
# 1. Start LogLens: npm run dev
# 2. In Slack: /log ping
# 3. Should respond: "LogLens is alive here"
# 4. Test message analysis: Right-click message → Analyze with LogLens
# 
# If you see errors, check:
# - All required tokens are set correctly
# - URLs are accessible from your deployment
# - Service integrations are configured properly

