{
  "name": "loglens-slack-app",
  "version": "1.0.0",
  "description": "Slack app for log analysis and client alerts with ephemeral action buttons",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/app.js",
    "dev": "tsx src/app.ts",
    "watch": "tsx watch src/app.ts",
    "postinstall": "npm run build"
  },
  "keywords": ["slack", "logs", "coralogix", "alerts"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  },
  "dependencies": {
    "@slack/bolt": "^3.17.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
